#!/bin/bash
set -e
# amun-printer/test — stage amun core + amun-docker + this plugin, run the amun
# harness (L2), then run tests/vm-e2e.sh inside the VM (amun/test --post).
#   ./test [platform] [amun/test flags...]    DEBUG=1 for a shell before teardown
#   AMUN_CORE=~/dev/amun ./test ...           local amun core instead of GitHub main
#   AMUN_DOCKER=~/dev/amun-docker ./test ...  local amun-docker instead of GitHub main
# The e2e clones cn-printer from GitHub main inside the VM (CN_PRINTER_REF to
# pin a branch/tag), so push cn-printer before running this.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN="$(basename "$SCRIPT_DIR")"
STAGING=$(mktemp -d)
trap 'rm -rf "$STAGING"' EXIT SIGINT SIGTERM

# Default platform for a bare ./test (override with any amun/test args).
if [ $# -eq 0 ]; then
    set -- debian
fi

if [ -n "${AMUN_CORE:-}" ]; then
    cp -r "$AMUN_CORE" "$STAGING/amun"
else
    git clone --depth 1 https://github.com/GonzaloAlvarez/amun.git "$STAGING/amun"
fi
# amun docker converges before amun printer: the printer host is a Docker host
# (cn-printer is the stack) and the e2e needs the engine.
if [ -n "${AMUN_DOCKER:-}" ]; then
    cp -r "$AMUN_DOCKER" "$STAGING/amun-docker"
elif [ -d "$(dirname "$SCRIPT_DIR")/amun-docker" ]; then
    cp -r "$(dirname "$SCRIPT_DIR")/amun-docker" "$STAGING/amun-docker"
else
    git clone --depth 1 https://github.com/GonzaloAlvarez/amun-docker.git "$STAGING/amun-docker"
fi
cp -r "$SCRIPT_DIR" "$STAGING/$PLUGIN"

# --post before -p: amun/test's -p greedily consumes trailing non-dash args.
exec "$STAGING/amun/test" "$@" --post "$STAGING/$PLUGIN/tests/vm-e2e.sh" -p docker "${PLUGIN#amun-}"
