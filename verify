#!/bin/bash
# amun-printer verify — Layer 4 host spot check (pure shell, no ansible on
# the target). Exits 0 iff every check passes; hardware-dependent checks
# print SKIP (never FAIL) when the Brother is not attached or the host is
# not a Raspberry Pi.
#
# Usage:
#   ./verify                                # local
#   ./verify --host printer.lan             # over ssh
#   ./verify --host rpid11.lan --user gonzalo
#
# homelab/CLAUDE.md "Provisioning verification" — every amun-* plugin ships
# ./molecule, ./test and ./verify.
set -u

HOST=""
TARGET_USER="gonzalo"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --host) HOST="$2"; shift 2 ;;
        --user) TARGET_USER="$2"; shift 2 ;;
        -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

if [[ -n "$HOST" ]]; then
    RUNNER() { ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "${TARGET_USER}@${HOST}" "$@"; }
else
    RUNNER() { bash -c "$*"; }
fi

PASS=0; FAIL=0; SKIP=0
check() {
    local label="$1"; shift
    if RUNNER "$*" >/dev/null 2>&1; then
        printf '  \033[32mPASS\033[0m  %s\n' "$label"; PASS=$((PASS + 1))
    else
        printf '  \033[31mFAIL\033[0m  %s\n' "$label"; FAIL=$((FAIL + 1))
    fi
}
skip() { printf '  \033[33mSKIP\033[0m  %s\n' "$1"; SKIP=$((SKIP + 1)); }

echo "== amun-printer verify =="
echo "Target: ${HOST:-localhost}  User: $TARGET_USER"
echo

IS_PI=0;  RUNNER "test -f /boot/firmware/cmdline.txt && command -v vcgencmd" >/dev/null 2>&1 && IS_PI=1
HAVE_DEV=0; RUNNER "grep -lqx 04f9 /sys/bus/usb/devices/*/idVendor" >/dev/null 2>&1 && HAVE_DEV=1
HAVE_UFW=0; RUNNER "test -x /usr/sbin/ufw || command -v ufw" >/dev/null 2>&1 && HAVE_UFW=1   # /usr/sbin is not in a user PATH on Debian 12+
echo "Raspberry Pi: $IS_PI   Brother USB attached: $HAVE_DEV   ufw: $HAVE_UFW"
echo

echo "Packages:"
for p in ipp-usb avahi-daemon avahi-utils sane-utils sane-airscan cups-ipp-utils; do
    check "$p present" "dpkg-query -W -f='\${Status}' $p 2>/dev/null | grep -q 'install ok installed'"
done
for p in cups cups-daemon cups-browsed samba nfs-kernel-server netatalk dnsmasq hostapd; do
    check "$p ABSENT (host)" "! dpkg-query -W -f='\${Status}' $p 2>/dev/null | grep -q 'install ok installed'"
done

echo
echo "Kernel / USB:"
check "usblp blacklisted"        "grep -qx 'blacklist usblp' /etc/modprobe.d/blacklist-usblp.conf"
check "usblp not loaded"         "! lsmod | grep -q '^usblp'"
if [[ $HAVE_DEV -eq 1 ]]; then
    check "ipp-usb active"       "systemctl is-active --quiet ipp-usb"
    check "ipp-usb answers on :60000"  "curl -sf -m 5 -o /dev/null http://127.0.0.1:60000/"
    check "printer answers IPP Get-Printer-Attributes" "printf '{ OPERATION Get-Printer-Attributes\nGROUP operation-attributes-tag\nATTR charset attributes-charset utf-8\nATTR language attributes-natural-language en\nATTR uri printer-uri \$uri\nSTATUS successful-ok\n}\n' > /tmp/gpa.test && ipptool -T 8 ipp://127.0.0.1:60000/ipp/print /tmp/gpa.test"
    check "eSCL capabilities reachable" "curl -sf -m 8 http://127.0.0.1:60000/eSCL/ScannerCapabilities | grep -qi scan"
else
    skip "ipp-usb active / IPP / eSCL — no Brother (04f9) on the USB bus"
fi

echo
echo "ipp-usb config:"
check "interface = all"          "grep -Eq '^\s*interface\s*=\s*all' /etc/ipp-usb/ipp-usb.conf"
check "dns-sd = disable"         "grep -Eq '^\s*dns-sd\s*=\s*disable' /etc/ipp-usb/ipp-usb.conf"
check "avahi-daemon active"      "systemctl is-active --quiet avahi-daemon"

echo
echo "Reliability:"
check "journald Storage=persistent" "systemd-analyze cat-config systemd/journald.conf 2>/dev/null | grep -qx 'Storage=persistent' || grep -qx 'Storage=persistent' /etc/systemd/journald.conf.d/99-amun-printer.conf"
check "/var/log/journal populated"  "test -n \"\$(ls -A /var/log/journal 2>/dev/null)\""
if [[ $IS_PI -eq 1 ]]; then
    check "watchdog armed (RuntimeWatchdogUSec != 0)" "systemctl show -p RuntimeWatchdogUSec | grep -Evq '=0\$|=\$'"
    check "dtparam=watchdog=on in config.txt"          "grep -qx 'dtparam=watchdog=on' /boot/firmware/config.txt"
    check "memory cgroup enabled"                      "grep -qw memory /sys/fs/cgroup/cgroup.controllers"
    check "rpi.prom fresh (<180 s)"  "f=/var/lib/node_exporter/textfile_collector/rpi.prom; test -f \$f && [ \$(( \$(date +%s) - \$(stat -c %Y \$f) )) -lt 180 ]"
    check "no under-voltage right now" "grep -qx 'rpi_undervoltage_now 0' /var/lib/node_exporter/textfile_collector/rpi.prom"
    check "throttle cron installed"  "test -f /etc/cron.d/rpi-throttled"
else
    skip "watchdog / memory cgroup / rpi.prom — not a Raspberry Pi"
fi

echo
echo "Storage:"
check "/srv/scans owned by $TARGET_USER" "test \"\$(stat -c %U /srv/scans)\" = '$TARGET_USER'"
check "/srv/scans mode 2775"        "test \"\$(stat -c %a /srv/scans)\" = '2775'"
check "/srv/scans/{swis,inbox,processed}" "test -d /srv/scans/swis && test -d /srv/scans/inbox && test -d /srv/scans/processed"

echo
echo "Firewall:"
if [[ $HAVE_UFW -eq 1 ]]; then
    check "ufw: 9100 from 10.1.1.140"   "sudo -n ufw status | grep -E '^9100/tcp\s+ALLOW IN\s+10\.1\.1\.140'"
    check "ufw: 9329 from 10.1.1.140"   "sudo -n ufw status | grep -E '^9329/tcp\s+ALLOW IN\s+10\.1\.1\.140'"
    check "ufw: 60000 from 172.16.0.0/12" "sudo -n ufw status | grep -E '^60000/tcp\s+ALLOW IN\s+172\.16\.0\.0/12'"
    check "ufw: no LAN hole on 60000"   "! sudo -n ufw status | grep -E '^60000/tcp\s+ALLOW IN\s+(Anywhere|10\.)'"
else
    skip "ufw rules — ufw not installed"
fi

echo
echo "Legacy services absent:"
for u in smbd nmbd nfs-server netatalk dnsmasq hostapd cups; do
    check "$u unit not enabled" "! systemctl is-enabled --quiet $u 2>/dev/null"
done

echo
echo "== Summary =="
echo "  Pass: $PASS"
echo "  Fail: $FAIL"
echo "  Skip: $SKIP"
[[ $FAIL -eq 0 ]] || exit 1
exit 0
